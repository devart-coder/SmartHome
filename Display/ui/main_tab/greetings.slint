// import { YandexWeatherFact } from "yandex_weather.slint";
import { Theme } from "../global/themes.slint";
import { GlobalConnectionsStatus, GlobalMainTab, GlobalBMP180 } from "../global/global_main_tab.slint";
export component Greetings inherits Rectangle {
    in-out property <color> device_background_color:Theme.background-color;
    in property <color> text_color:Theme.text-color;
    in property <color> header_color:Theme.text-color;
    private property <color> hot_color:#ff5722;
    private property <color> cold_color:#00bcd4;
    private property <color> warm_color:#E69A3B;
    in property <string> greetings;
    border-radius: Theme.border-radius;
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../pictures/backgrounds/hb_1.jpg");
        image-fit: ImageFit.cover;
    }
    VerticalLayout {
        spacing: 8px;
        padding: 10px;
        Rectangle {
            background: black.with-alpha(0.7);
            border-radius: Theme.border-radius;
            VerticalLayout {
                padding: 10px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: greetings;
                        color: header_color;
                        font-size: 24px;
                        horizontal-alignment: start;
                        horizontal-stretch: 10;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        mqtt_image:=Image {
                            TouchArea {
                               clicked => {
                                    GlobalConnectionsStatus.mqtt_button_pressed();
                               }
                            }
                            source: @image-url("../icons/mqtt-icon-solid.svg");
                            horizontal-alignment: ImageHorizontalAlignment.right;
                            colorize: GlobalConnectionsStatus.mqtt_status=="connected"?
                            Theme.text-color:Theme.text-color.darker(2);
                            animate colorize { duration: 250ms; easing: ease-in-out; }
                        }
                        Timer {
                            interval: 500ms;
                            running:
                            GlobalConnectionsStatus.mqtt_status=="connecting"
                            ? true : false;
                            property <bool> status:false;
                            triggered => {
                                if(!status){
                                    mqtt_image.colorize=header_color.darker(2);
                                    status=!status;
                                }
                                else{
                                    mqtt_image.colorize=header_color;
                                    status=!status;
                                }
                            }
                        }
                        Image {
                            source: GlobalConnectionsStatus.wifi_status == "online" ?
                                @image-url("../icons/wifi.svg") : @image-url("../icons/wifi-off.svg");
                            colorize: header_color;
                            horizontal-alignment: ImageHorizontalAlignment.right;
                        }
                    }
                }
                Text {
                    text: GlobalMainTab.time;
                    color: text_color;
                    font-size: 16px;
                    horizontal-alignment: start;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 30px;
            padding-left: 10px;
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding: 10px;
                    Text {
                        text: "🌡️ "+ GlobalBMP180.temperature +" °C";
                        font-size: 16px;
                        padding: 10px;
                        color: GlobalBMP180.temperature > 25 ?
                        hot_color :
                        GlobalBMP180.temperature <=25
                        && GlobalBMP180.temperature >=18 ?
                        warm_color : cold_color;
                    }
                }
            }
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        padding: 10px;
                        color: text_color;
                        text: "🎈 "+ GlobalBMP180.pressure + " мм.рт.";
                        font-size: 16px;
                    }
                }
            }
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: "⛰️ " + GlobalBMP180.altitude + " м";
                        font-size: 16px;
                        vertical-alignment: center;
                        color: text_color;
                    }
                }
            }
            Rectangle {}
        }
        Rectangle {
        }
    }
}
