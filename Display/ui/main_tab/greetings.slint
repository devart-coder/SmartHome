import { YandexWeatherFact } from "yandex_weather.slint";
import { Theme } from "../themes.slint";
export component Greetings inherits Rectangle {
    in-out property <color> device_background_color:Theme.background-color;
    in property <color> text_color:Theme.text-color;
    in property <color> header_color:Theme.text-color;
    private property <color> hot_color:#ff5722;
    private property <color> cold_color:#00bcd4;
    private property <color> warm_color:#E69A3B;
    in property <string> greetings;
    in-out property <string> temperature;
    in-out property <string> time;
    in-out property <string> pressure;
    in-out property <string> altitude;
    in-out property <string> wifi_status:"offline";
    in-out property <string> mqtt_status;

    border-radius: 8px;
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../pictures/backgrounds/hb_1.jpg");
        image-fit: ImageFit.cover;
    }
    VerticalLayout {
        spacing: 8px;
        padding: 10px;
        Rectangle {
            background: black.with-alpha(0.7);
            border-radius: 8px;
            VerticalLayout {
                padding: 10px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: greetings;
                        color: header_color;
                        font-size: 24px;
                        horizontal-alignment: start;
                        horizontal-stretch: 10;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        mqtt_image:=Image {
                            source: @image-url("../icons/mqtt-icon-solid.svg");
                            horizontal-alignment: ImageHorizontalAlignment.right;
                            animate colorize { duration: 250ms; easing: ease-in-out; }
                        }
                        timer:=Timer {
                            interval: 500ms;
                            running: true;
                            property <bool> status: false;
                            triggered => {
                                if(!status){
                                    mqtt_image.colorize=header_color.darker(2);
                                    status=!status;
                                }
                                else{
                                    mqtt_image.colorize=header_color;
                                    status=!status;
                                }
                            }
                        }
                        Image {
                            source: wifi_status == "online" ?
                                @image-url("../icons/wifi.svg") : @image-url("../icons/wifi-off.svg");
                            colorize: header_color;
                            horizontal-alignment: ImageHorizontalAlignment.right;
                        }
                    }
                }
                Text {
                    text: time;
                    color: text_color;
                    font-size: 16px;
                    horizontal-alignment: start;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 30px;
            padding-left: 10px;
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding: 10px;
                    Text {
                        text: "🌡️ "+ temperature +" °C";
                        font-size: 16px;
                        padding: 10px;
                        color: temperature > 25 ? hot_color : temperature <=25 && temperature >=18 ? warm_color : cold_color;
                    }
                }
            }
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        padding: 10px;
                        color: text_color;
                        text: "🎈 "+ pressure + " мм.рт.";
                        font-size: 16px;
                    }
                }
            }
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: "⛰️ " + altitude + " м";
                        font-size: 16px;
                        vertical-alignment: center;
                        color: text_color;
                    }
                }
            }
            Rectangle {}
        }
        Rectangle {
        }
    }
}
