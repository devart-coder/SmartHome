import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlobalWeather } from "../global/global_main_tab.slint";
import { Theme } from "../global/themes.slint";

export component YandexWeatherFact inherits Rectangle{
    private property <brush> background_color_sunny: #D97724;
    private property <brush> background_color_cloudy: #1E1F24;
    private property <brush> background_color_rain: #0F172A;
    private property <brush> background_color_snow: #111C24;
    private property <brush> background_default: #0F121A;
    in property <length> popup_x;
    in property <length> popup_y;
    // in-out property <WeatherFact> weather;
    // in-out property <string> weather_status: "offline";
    border-radius: 8px;
    border-width: 2px;
    border-color: GlobalWeather.weather_status == "online" ?
        (
            GlobalWeather.weather.status == "clear" ? background_color_sunny.brighter(0.25) : // 1. Солнечно
            (GlobalWeather.weather.status == "partly-cloudy" ||
                GlobalWeather.weather.status == "cloudy" ||
                GlobalWeather.weather.status == "overcast") ? background_color_cloudy.brighter(0.25) : // 2. Облачно
            (GlobalWeather.weather.status == "light-rain" ||
                GlobalWeather.weather.status == "rain" ||
                GlobalWeather.weather.status == "heavy-rain" ||
                GlobalWeather.weather.status == "showers" ||
                GlobalWeather.weather.status == "thunderstorm" ||
                GlobalWeather.weather.status == "thunderstorm-with-rain" ||
                GlobalWeather.weather.status == "hail" ||
                GlobalWeather.weather.status == "thunderstorm-with-hail"
            ) ? background_color_rain.brighter(0.25) : // 3. Дождь/Гроза
            background_color_snow.brighter(0.25)
        ) : background_default.brighter(0.25);
    background:GlobalWeather.weather_status == "online" ?
        (
            GlobalWeather.weather.status == "clear" ? background_color_sunny : // 1. Солнечно
            (GlobalWeather.weather.status == "partly-cloudy" ||
                GlobalWeather.weather.status == "cloudy" ||
                GlobalWeather.weather.status == "overcast") ? background_color_cloudy : // 2. Облачно
            (GlobalWeather.weather.status == "light-rain" ||
                GlobalWeather.weather.status == "rain" ||
                GlobalWeather.weather.status == "heavy-rain" ||
                GlobalWeather.weather.status == "showers" ||
                GlobalWeather.weather.status == "thunderstorm" ||
                GlobalWeather.weather.status == "thunderstorm-with-rain" ||
                GlobalWeather.weather.status == "hail" ||
                GlobalWeather.weather.status == "thunderstorm-with-hail") ? background_color_rain : // 3. Дождь/Гроза
            background_color_snow
        ) : background_default;
    my_popup := PopupWindow {
        x: (-popup_x + self.width)/2;
        y: (popup_y - self.height)/2;
        Rectangle {
            border-radius: 8px;
            border-width: 2px;
            border-color: darkcyan;
            background: GlobalWeather.weather_status == "online" ?
                    (
                        GlobalWeather.weather.status == "clear" ? background_color_sunny : // 1. Солнечно
                        (GlobalWeather.weather.status == "partly-cloudy" ||
                            GlobalWeather.weather.status == "cloudy" ||
                            GlobalWeather.weather.status == "overcast") ? background_color_cloudy : // 2. Облачно
                        (GlobalWeather.weather.status == "light-rain" ||
                            GlobalWeather.weather.status == "rain" ||
                            GlobalWeather.weather.status == "heavy-rain" ||
                            GlobalWeather.weather.status == "showers" ||
                            GlobalWeather.weather.status == "thunderstorm" ||
                            GlobalWeather.weather.status == "thunderstorm-with-rain" ||
                            GlobalWeather.weather.status == "hail" ||
                            GlobalWeather.weather.status == "thunderstorm-with-hail") ? background_color_rain : // 3. Дождь/Гроза
                        background_color_snow
                    ) : background_default;
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                alignment: center;
                Text {
                    text: "Детальная информация";
                    color: Theme.text-color;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
                //Общая информаци
                Text {
                    text:
                        "Состояние: " + GlobalWeather.weather.condition + "\n" +
                        "Температура: " + GlobalWeather.weather.temp +
                        " (" + GlobalWeather.weather.feels-like + ")\n" +
                        "Влажность: " + GlobalWeather.weather.humidity + "\n" +
                        "Давление: " + GlobalWeather.weather.pressure-mm + "мм.рс. ("
                        + GlobalWeather.weather.pressure-pa + " гПа)\n";
                    color: Theme.text-color;
                    font-size: 14px;
                    horizontal-alignment: start;
                }
                //Облачность
                Text {
                    text:
                        "Облачность: " + GlobalWeather.weather.cloudness + "\n" +
                        "Вероятность осадков: " + GlobalWeather.weather.prec-type + " ("+
                        GlobalWeather.weather.prec-prob + ")\n" +
                        "Гроза: " + GlobalWeather.weather.is_thunder;
                    color: Theme.text-color;
                    font-size: 14px;
                    horizontal-alignment: start;
                }
                //Ветер
                Text {
                    text:
                        "Скорость: " + GlobalWeather.weather.wind_speed + " м/с\n" +
                        "Порывы до: " + GlobalWeather.weather.wind_gust + " м/с\n" +
                        "Направление: " + GlobalWeather.weather.wind_dir;
                    color: Theme.text-color;
                    font-size: 14px;
                    horizontal-alignment: start;
                }
            }
        }
    }
    Text {
        x:parent.width - self.width;
        y:parent.height - self.height;
        font-size: 90px;
        opacity: 0.15;
        text:
            GlobalWeather.weather.status == "clear" ? "☀️" :
            GlobalWeather.weather.status == "partly-cloudy" ||
            GlobalWeather.weather.status == "cloudy" ? "⛅" :
            GlobalWeather.weather.status == "overcast" ? "☁️" :
            GlobalWeather.weather.status == "light-rain" ||
            GlobalWeather.weather.status == "rain" ? "🌧️" :
            GlobalWeather.weather.status == "thunderstorm-with-hail" ||
            GlobalWeather.weather.status == "thunderstorm-with-rain" ||
            GlobalWeather.weather.status == "heavy-rain"  ? "⛈️" :
            GlobalWeather.weather.status == "showers" ? "🌊" :
            GlobalWeather.weather.status == "light-snow" ||
            GlobalWeather.weather.status == "snow" ? "❄️" :
            GlobalWeather.weather.status == "snow-showers" ? "☃️" :
            GlobalWeather.weather.status == "hail" ? "🪨" :
            GlobalWeather.weather.status == "thunderstorm" ? "⚡" :
            "🌙";
        color:
            GlobalWeather.weather.status == "sunny" ? background_color_sunny : // 1. Солнечно
            (GlobalWeather.weather.status == "partly-cloudy" ||
                GlobalWeather.weather.status == "cloudy" ||
                GlobalWeather.weather.status == "overcast") ? background_color_cloudy.darker(0.4) : // 2. Облачно
            (GlobalWeather.weather.status == "light-rain" ||
                GlobalWeather.weather.status == "rain" ||
                GlobalWeather.weather.status == "heavy-rain" ||
                GlobalWeather.weather.status == "showers" ||
                GlobalWeather.weather.status == "thunderstorm" ||
                GlobalWeather.weather.status == "thunderstorm-with-rain" ||
                GlobalWeather.weather.status == "thunderstorm-with-hail") ?
                background_color_rain.darker(0.4) : // 3. Дождь/Гроза
            background_color_snow.darker(0.4);
        }
    touch_wind := TouchArea {
        clicked => { my_popup.show(); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        Text {
            color: Theme.text-color;
            horizontal-alignment: center;
            text: "Погода";
            font-size: 24px;
        }
        Rectangle {
            border-radius: Theme.border-radius;
            background: Theme.background-color;
            vertical-stretch: 1;
            Text {
                visible: GlobalWeather.weather_status == "offline" ? true:false;
                font-size: 50px;
                color:Theme.text-color;
                width: 50%;
                height: 50%;
                text: "🔌";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            VerticalLayout {
                visible: GlobalWeather.weather_status == "online"? true:false;
                spacing:10px;
                padding: 10px;
                Text {
                    horizontal-alignment: center;
                    color: Theme.text-color;
                    text: GlobalWeather.weather.condition +
                    (
                        GlobalWeather.weather.status == "clear" ? " ☀️" :
                        GlobalWeather.weather.status == "partly-cloudy" ||
                        GlobalWeather.weather.status == "cloudy" ? " ⛅" :
                        GlobalWeather.weather.status == "overcast" ? " ☁️" :
                        GlobalWeather.weather.status == "light-rain" ||
                        GlobalWeather.weather_status == "rain" ? " 🌧️" :
                        GlobalWeather.weather.status == "thunderstorm-with-hail" ||
                        GlobalWeather.weather.status == "thunderstorm-with-rain" ||
                        GlobalWeather.weather.status == "heavy-rain"  ? " ⛈️" :
                        GlobalWeather.weather.status == "showers" ? " 🌊" :
                        GlobalWeather.weather.status == "light-snow" ||
                        GlobalWeather.weather.status == "snow" ? " ❄️" :
                        GlobalWeather.weather.status == "snow-showers" ? " ☃️" :
                        GlobalWeather.weather.status == "hail" ? " 🪨" :
                        GlobalWeather.weather.status == "thunderstorm" ? " ⚡" :
                        ""
                    );
                    font-size: 16px;
                }
                Text {
                    horizontal-alignment: center;
                    color: Theme.text-color;
                    text: "🌡️ " + GlobalWeather.weather.temp + " °C (" + GlobalWeather.weather.feels-like + " °C)";
                    font-size: 16px;
                }
                Text {
                    horizontal-alignment: center;
                    color: Theme.text-color;
                    text: "Влажность 💧 " + GlobalWeather.weather.humidity + " %";
                    font-size: 16px;
                }
                Text {
                    horizontal-alignment: center;
                    color: Theme.text-color;
                    text:
                        GlobalWeather.weather.prec-type == "Без осадков" ?
                        GlobalWeather.weather.prec-type : GlobalWeather.weather.prec-type + " ("+ GlobalWeather.weather.prec-prob + " %)";
                    font-size: 16px;
                }
                Text {
                    color: Theme.text-color;
                    horizontal-alignment: center;
                    text: "Ветер 💨 " + GlobalWeather.weather.wind-speed + " м/с";
                    font-size: 16px;
                }
                Rectangle {}
            }
        }
    }
}
