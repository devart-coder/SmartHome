import { StandardButton, VerticalBox } from "std-widgets.slint";
import { Theme } from "../global/themes.slint";
import { GlobalLightControllGroups } from "../global/global_main_tab.slint";
export component LightControll inherits Rectangle{
    border-radius: Theme.border-radius;
    border-width: Theme.border-width;
    background: Theme.background-color;
    border-color: self.background.brighter(0.25);
    GridLayout {
        padding: 10px;
        spacing: 10px;
        Row {
            for room[index] in ["Кухня","Прихожая","Зал","Кладовая"] : room_rect_1:= Rectangle{
                min-height: 30px;
                border-radius: Theme.border-radius;
                border-width: Theme.border-width;
                background: Theme.background-color.brighter(0.25);
                border-color: GlobalLightControllGroups.light_controll_g1[index].is-on ?
                    Theme.border-color : self.background.brighter(0.25);
                TouchArea {
                    clicked => {
                        GlobalLightControllGroups.light_controll_g1[index].is-on =!
                            GlobalLightControllGroups.light_controll_g1[index].is-on;
                        GlobalLightControllGroups.g1_status(GlobalLightControllGroups.light_controll_g1[index].name,
                            GlobalLightControllGroups.light_controll_g1[index].is-on);
                    }
                }
                Text {
                    text: room;
                    color: Theme.text-color;
                    horizontal-alignment: center;
                    font-size: 16px;
                    vertical-alignment: top;
                }
            }
        }
        Row {
            for room[index] in ["ЦУ","Уборная","Ванная","Покои"] : room_rect_2:= HorizontalLayout{
                    spacing: 10px;
                    Rectangle {
                        width: 32px;
                        border-radius: Theme.border-radius;
                        border-width: Theme.border-width;
                        background: Theme.background-color.brighter(0.25);
                        border-color: self.background.brighter(0.25);
                        TouchArea {
                            clicked => {
                                 GlobalLightControllGroups.light_controll_g2[index].ownship=! GlobalLightControllGroups.light_controll_g2[index].ownship;
                                 GlobalLightControllGroups.g2_ownership( GlobalLightControllGroups.light_controll_g2[index].name,  GlobalLightControllGroups.light_controll_g2[index].ownship);
                            }
                        }
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: Theme.background-color.brighter(0.25);
                            border-color:  GlobalLightControllGroups.light_controll_g2[index].ownship ? Theme.border-color : self.background.brighter(1.25);
                            border-width: Theme.border-width;
                            y: GlobalLightControllGroups.light_controll_g2[index].ownship? parent.y + 3px : parent.height - 26px - 3px;
                            animate y { duration: 250ms; easing: ease-in-out; }
                            animate border-color { duration: 250ms; }
                        }
                    }
                    Rectangle{
                        min-height: 30px;
                        border-radius: Theme.border-radius;
                        border-width: Theme.border-width;
                        background: Theme.background-color.brighter(0.25);
                        border-color:  GlobalLightControllGroups.light_controll_g2[index].is-on ? Theme.border-color : self.background.brighter(0.25);
                        animate background { duration: 250ms; }
                        animate border-color { duration: 250ms; }
                        TouchArea {
                            clicked => {
                                 GlobalLightControllGroups.light_controll_g2[index].is-on=!
                                 GlobalLightControllGroups.light_controll_g2[index].is-on;

                                 GlobalLightControllGroups.light_controll_g2[index].ownship =
                                 GlobalLightControllGroups.light_controll_g2[index].is-on
                                 ? true :
                                 GlobalLightControllGroups.light_controll_g2[index].ownship;

                                 GlobalLightControllGroups.g2_ownership(
                                 GlobalLightControllGroups.light_controll_g2[index].name,
                                 GlobalLightControllGroups.light_controll_g2[index].ownship);
                                 GlobalLightControllGroups.g2_status(
                                 GlobalLightControllGroups.light_controll_g2[index].name,
                                 GlobalLightControllGroups.light_controll_g2[index].is-on);
                            }
                        }
                        Text {
                            text: room;
                            color: Theme.text-color;
                            horizontal-alignment: center;
                            font-size: 16px;
                            vertical-alignment: top;
                        }
                    }
            }
        }
    }
}
