import { Greetings } from "greetings.slint";
import { YandexWeatherFact } from "yandex_weather.slint";
import { Theme } from "../global/themes.slint";
import { LightControll } from "light_controll.slint";
export component MainTab inherits Rectangle{
    in-out property <int> conditioner_value:25;
    in property <length> popup_x;
    in property <length> popup_y;
    in-out property <image> gif-frame;
    HorizontalLayout {
        padding: 10px;
        VerticalLayout {
            padding-top: 10px;
            padding-left: 10px;
            padding-bottom: 10px;
            spacing: 10px;
            HorizontalLayout {
            max-height: root.height/2;
                Greetings {
                    greetings: "Приветствие";
                    border-color: Theme.border-color;
                    border-width: Theme.border-width;
                    horizontal-stretch: 5;
                    height: 50%;
                }
                YandexWeatherFact {
                    height: 50%;
                    popup_x:popup_x;
                    popup_y:popup_y;
                }
            }
            VerticalLayout {
                spacing: 10px;
                LightControll {}
            }
        }
    }
}
