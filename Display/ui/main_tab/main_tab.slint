import { Greetings } from "greetings.slint";
import { WeatherFact, YandexWeatherFact } from "yandex_weather.slint";
import { MediaPlayer } from "media_player.slint";
import { LightControll, LightObject } from "light_controll.slint";
import { Slider, VerticalBox, HorizontalBox, Spinner } from "std-widgets.slint";
import { ConditionerControll } from "conditioner_control.slint";
import { Theme } from "../themes.slint";
export component MainTab inherits Rectangle{
    in-out property <string> time: "____, --:-- --.--.--";
    in-out property <string> temperature: "--";
    in-out property <string> pressure: "--";
    in-out property <string> altitude: "--";
    in-out property <WeatherFact> weather;
    in-out property <string> wifi_status:"offline";
    in-out property <string> weather_status: "offline";
    in-out property <int> conditioner_value:25;
    in property <length> popup_x;
    in property <length> popup_y;
    in-out property <image> gif-frame;
    in-out property <[LightObject]> light_controll_g1;
    in-out property <[LightObject]> light_controll_g2;
    in-out property <string> mqtt_status;
    callback g1_status(string,bool);
    callback g2_status(string,bool);
    callback g2_ownership(string,bool);
    callback g1_ownership(string,bool);
    HorizontalLayout {
        padding: 10px;
        VerticalLayout {
            padding-top: 10px;
            padding-left: 10px;
            padding-bottom: 10px;
            spacing: 10px;
            HorizontalLayout {
            max-height: root.height/2;
                Greetings {
                    greetings: "Приветствие";
                    time: time;
                    temperature: temperature;
                    pressure: pressure;
                    altitude: altitude;
                    border-color: Theme.border-color;
                    border-width: Theme.border-width;
                    horizontal-stretch: 5;
                    height: 50%;
                    wifi_status: wifi_status;
                    mqtt_status:mqtt_status;
                }
                YandexWeatherFact {
                    weather_status: weather_status;
                    weather: weather;
                    height: 50%;
                    popup_x:popup_x;
                    popup_y:popup_y;
                }
            }
            VerticalLayout {
                // in-out property <bool> is_on:false ;
                // in-out property <int> current_mode:-1;
                spacing: 10px;
                LightControll {
                    light_controll_g1: light_controll_g1;
                    light_controll_g2: light_controll_g2;
                    g1_status(string,bool) => {root.g1_status(string,bool)};
                    g2_status(string,bool) => {root.g2_status(string,bool)};

                    g1_ownership(string,bool) => {root.g1_ownership(string, bool)};
                    g2_ownership(string,bool) => {root.g2_ownership(string, bool)};
                }
                // ConditionerControll {
                    // widget_background_color: widget_background_color;
                    // conditioner_value: conditioner_value;
                    // is_on: is_on;
                // }
            }
        }
    }
}
