global Theme{
    out property <color> system-background-color:#0F121A;
    out property <color> system-text-color:#00ffcc;
    out property <color> background-color:self.system-background-color.brighter(0.25);
    out property <color> text-color:#A0A0AA;
    out property <color> primary-color:background-color.brighter(0.25);
    out property <length> border-width:2px;
    // out property <color> border-color:#00ffcc;
    out property <color> border-color:royalblue;
    out property <length> border-radius:8px;
}
