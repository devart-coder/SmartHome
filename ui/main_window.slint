import { Button, Slider, Switch, ScrollView, ProgressIndicator } from "std-widgets.slint";
import { MainTab } from "main_tab/main_tab.slint";
import { WeatherFact } from "main_tab/yandex_weather.slint";
export component MainWindow inherits Window {
// Свойства для связи с Rust
    in-out property <string> ota-status: "Ожидание обновления";
    in-out property <float> ota-progress: 0.0; // от 0.0 до 1.0
    callback start-ota-clicked();
    Text {
        visible: false;
        font-size: 16px;
        text: "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя";
    }
    private property <brush> window_background_color: #0F121A;
    private property <brush> widget_background_color: window_background_color.brighter(0.25);
    private property <brush> front_color: #F5F5F7;
    private property <brush> front_color_second: #A0A0AA;
    private property <brush> widget_choosed: #00ffcc;
    in-out property <image> gif-frame;
    background: window_background_color;
    width: 800px;
    height: 480px;
    // in-out property <bool> is_loading: true;
    in-out property <bool> is_loading: false;
    in-out property <string> boot_logs: "Инициализация системы...\n";
    if(root.is_loading):Rectangle{
        background: #000000;
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            alignment: start;

            Text {
                text: "[ЗАГРУЗКА СИСТЕМЫ]";
                color: #00ffcc;
                font-size: 16px;
            }
            Text {
                text: root.boot_logs;
                color: #ffffff;
                font-size: 16px;
                wrap: word-wrap;
            }
            Text {
                    visible: false;
                    // font-family: "Roboto";
                    font-size: 16px;
                    text: "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя 0123456789 🌡️🎈💧💨 ✅❌🕒⚙️⏳📡🔍⏰⚠️🕹️";
                }
        }
    }

    in-out property <int> current-tab: 0;
    in-out property <string> global-time: "____, --:-- --.--.--";
    in-out property <string> global-temp: "--";
    in-out property <string> global-pressure: "--";
    in-out property <WeatherFact> global-weather;
    in-out property <string> global-altitude:"--";
    in-out property <string> global-wifi_status : "offline";
    in-out property <string> global-weather_status:"offline";
    if(!root.is_loading):HorizontalLayout {
        width: root.width;
        VerticalLayout {
            max-width: 50px;
            padding-top: 10px;
            padding-bottom: 10px;
            padding-left: 10px;
            Rectangle {
                background: widget_background_color;
                border-radius: 8px;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 25px;
                    alignment: center;
                    for tab-idx[index] in ["🏠", "📱", "🪄", "☀️", "📊", "📹", "⚙️" ] : Rectangle {
                        background: root.current-tab == index ? widget_background_color.brighter(0.25) : widget_background_color;
                        border-radius: 8px;
                        TouchArea {
                            clicked => { root.current-tab = index; }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: tab-idx;
                                    color: root.current-tab == index ? front_color : front_color_second;
                                    font-size: 36px;
                                    font-weight: 1000;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
        MainTab {
            visible: root.current-tab == 0;
            wifi_status: global-wifi_status;
            front_color: front_color;
            widget_background_color: widget_background_color;

            time: global-time;
            temperature: global-temp;
            pressure: global-pressure;

            weather: global-weather;
            altitude: global-altitude;
            weather_status: global-weather_status;
            popup_x:root.width;
            popup_y:root.height;
        }
    }
}
