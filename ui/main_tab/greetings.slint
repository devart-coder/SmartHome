import { YandexWeatherFact } from "yandex_weather.slint";
export component Greetings inherits Rectangle {
    in property <brush> device_background_color;
    in property <brush> text_color;
    in property <brush> header_color;
    private property <brush> hot_color:#ff5722;
    private property <brush> cold_color:#00bcd4;
    private property <brush> warm_color:#E69A3B;
    in property <string> greetings;
    in-out property <string> temperature;
    in-out property <string> time;
    in-out property <string> pressure;
    in-out property <string> altitude;
    in-out property <string> wifi_status:"offline";
    border-radius: 8px;
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../pictures/backgrounds/hb_1.jpg");
        image-fit: ImageFit.cover;
    }
    VerticalLayout {
        spacing: 8px;
        padding: 10px;
        Rectangle {
            background: black.with-alpha(0.7);
            border-radius: 8px;
            VerticalLayout {
                padding: 10px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: greetings;
                        color: header_color;
                        font-size: 24px;
                        horizontal-alignment: start;
                        horizontal-stretch: 10;
                    }
                    Image {
                        source: wifi_status == "online" ?
                            @image-url("../icons/wifi.svg") : @image-url("../icons/wifi-off.svg");
                        colorize: header_color;
                        horizontal-alignment: ImageHorizontalAlignment.right;
                    }
                }
                Text {
                    text: time;
                    color: text_color;
                    font-size: 16px;
                    horizontal-alignment: start;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 30px;
            padding-left: 10px;
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding: 10px;
                    Text {
                        text: "🌡️ "+ temperature +" °C";
                        font-size: 16px;
                        padding: 10px;
                        color: temperature > 25 ? hot_color : temperature <=25 && temperature >=18 ? warm_color : cold_color;
                    }
                }
            }
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        padding: 10px;
                        color: text_color;
                        text: "🎈 "+ pressure + " мм.рт.";
                        font-size: 16px;
                    }
                }
            }
            Rectangle {
                background: black.with-alpha(0.7);
                border-radius: 8px;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: "⛰️ " + altitude + " м";
                        font-size: 16px;
                        vertical-alignment: center;
                        color: text_color;
                    }
                }
            }
            Rectangle {}
        }
        Rectangle {
        }
    }
}
