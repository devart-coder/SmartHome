import { Greetings } from "greetings.slint";
import { WeatherFact, YandexWeatherFact } from "yandex_weather.slint";
import { MediaPlayer } from "media_player.slint";
import { LightControll } from "light_control.slint";
import { Slider, VerticalBox, HorizontalBox, Spinner } from "std-widgets.slint";
import { ConditionerControll } from "conditioner_control.slint";
export component MainTab inherits Rectangle{
    in-out property <string> time: "____, --:-- --.--.--";
    in-out property <string> temperature: "--";
    in-out property <string> pressure: "--";
    in-out property <string> altitude: "--";
    in-out property <WeatherFact> weather;
    in property <brush> widget_background_color;
    in property <brush> front_color;
    in-out property <string> wifi_status:"offline";
    in-out property <string> weather_status: "offline";
    in-out property <int> conditioner_value:25;
    in property <length> popup_x;
    in property <length> popup_y;
    in-out property <image> gif-frame;
    HorizontalLayout {
        padding: 10px;
        VerticalLayout {
            padding-top: 10px;
            padding-left: 10px;
            padding-bottom: 10px;
            spacing: 10px;
            Greetings {
                greetings: "Приветствие";
                time: time;
                temperature: temperature;
                pressure: pressure;
                altitude: altitude;
                background: widget_background_color;
                device_background_color:widget_background_color.brighter(0.25);
                text_color: front_color.darker(0.25);
                header_color: front_color;
                border-color: widget_background_color.brighter(0.25);
                border-width: 2px;
                horizontal-stretch: 5;
                height: 50%;
                wifi_status: wifi_status;
            }
            VerticalLayout {
                in-out property <bool> is_on:false ;
                in-out property <int> current_mode:-1;
                spacing: 10px;
                LightControll { widget_background: widget_background_color; }
                ConditionerControll {
                    widget_background_color: widget_background_color;
                    conditioner_value: conditioner_value;
                    is_on: is_on;
                }
            }
        }
        VerticalLayout {
            padding: 10px;
            spacing : 10px;
            YandexWeatherFact {
                weather_status: weather_status;
                weather: weather;
                height: 50%;
                popup_x:popup_x;
                popup_y:popup_y;
            }
            MediaPlayer {
                front_color: front_color;
                widget_background_color: widget_background_color;
                gif-frame: gif-frame;
            }
        }
    }
}
